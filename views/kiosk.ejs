<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Kiosk</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    body { 
      font-family: Arial; 
      text-align: center; 
      padding: 20px; 
      background: #fff; 
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .wrapper {
      width: 100%;
      max-width: 1200px;
    }
    img { width: 100px; margin: 20px auto; display: block; }
    h1 { font-size: clamp(1.5rem, 5vw, 2.5rem); margin: 20px; }
    .badge { 
      background: #fff; 
      color: #000; 
      padding: 10px 20px; 
      border-radius: 20px; 
      display: inline-block; 
      margin: 20px; 
      border: 2px solid #000;
      font-size: clamp(0.9rem, 3vw, 1.1rem);
    }
    .btns { 
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
      gap: 20px; 
      margin: 40px auto; 
      padding: 0 10px;
      max-width: 100%;
    }
    .btn { 
      padding: clamp(30px, 8vw, 50px); 
      border: none;
      border-radius: 28px; 
      cursor: pointer; 
      font-size: clamp(1rem, 3vw, 1.3rem);
      font-weight: 600;
      transition: all 0.3s;
      touch-action: manipulation;
      -webkit-user-select: none;
      user-select: none;
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }
    .btn:active { transform: scale(0.95); }
    .btn:hover { transform: translateY(-5px); box-shadow: 0 14px 28px rgba(0,0,0,0.22); }
    .green { background: linear-gradient(135deg, #0ba360, #3ddc84); color: #fff; }
    .yellow { background: linear-gradient(135deg, #ffb88c, #ff9a56); color: #5a3418; }
    .red { background: linear-gradient(135deg, #e91e63, #ff5252); color: #fff; }
    .emoji { font-size: clamp(60px, 15vw, 90px); display: block; margin-bottom: 15px; }

    #thanksScreen { display: none; }
    #thanksScreen h1 { font-size: clamp(2rem, 8vw, 3.5rem); color: #4CAF50; margin: 20px; }
    #thanksScreen h2 { font-size: clamp(1.2rem, 4vw, 2rem); color: #333; margin: 20px; }
    
    /* Floating fullscreen button */
    #fullscreenBtn {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: #000;
      color: #fff;
      border: none;
      padding: 15px 25px;
      border-radius: 50px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
      z-index: 9999;
      display: none;
      animation: pulse 2s infinite;
    }
    
    #fullscreenBtn.show {
      display: block;
    }
    
    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
    
    @media (max-width: 768px) {
      body { padding: 10px; }
      img { width: 80px; margin: 15px auto; }
      h1 { margin: 15px; }
      .badge { padding: 8px 15px; margin: 15px; }
      .btns { gap: 15px; margin: 20px auto; }
      #fullscreenBtn { bottom: 15px; right: 15px; padding: 12px 20px; font-size: 0.9rem; }
    }
    
    @media (max-width: 480px) {
      img { width: 60px; margin: 10px auto; }
      .btns { gap: 10px; margin: 15px auto; }
      .btn { padding: 25px; border-width: 3px; }
    }
  </style>
</head>
<body>
  <div class="wrapper" id="ratingScreen">
    <img src="https://upload.wikimedia.org/wikipedia/commons/9/90/Mercedes-Logo.svg">
    <h1>Jak oceniasz wizytę w serwisie?</h1>
    <div class="badge"><%= name %></div>
    <div class="btns">
      <button class="btn green" onclick="go('happy')">
        <span class="emoji">😊</span>
        Bardzo dobrze
      </button>
      <button class="btn yellow" onclick="go('neutral')">
        <span class="emoji">😐</span>
        W porządku
      </button>
      <button class="btn red" onclick="go('sad')">
        <span class="emoji">☹️</span>
        Źle
      </button>
    </div>
  </div>

  <div class="wrapper" id="thanksScreen">
    <img src="https://upload.wikimedia.org/wikipedia/commons/9/90/Mercedes-Logo.svg">
    <h1>Dziękujemy, Twoja opinia jest dla nas ważna</h1>
    <h2>Daimler Truck Retail Polska</h2>
  </div>
  
  <button id="fullscreenBtn" onclick="activateFullscreen()">🖥️ Włącz pełny ekran</button>
  
  <script>
    const fsBtn = document.getElementById('fullscreenBtn');
    
    function checkFullscreen() {
      const isFullscreen = document.fullscreenElement || 
                          document.webkitFullscreenElement || 
                          document.mozFullScreenElement || 
                          document.msFullscreenElement;
      
      if (!isFullscreen) {
        fsBtn.classList.add('show');
      } else {
        fsBtn.classList.remove('show');
      }
    }
    
    function activateFullscreen() {
      const elem = document.documentElement;
      
      if (elem.requestFullscreen) {
        elem.requestFullscreen();
      } else if (elem.webkitRequestFullscreen) {
        elem.webkitRequestFullscreen();
      } else if (elem.mozRequestFullScreen) {
        elem.mozRequestFullScreen();
      } else if (elem.msRequestFullscreen) {
        elem.msRequestFullscreen();
      }
    }
    
    // Zawsze próbuj automatycznie włączyć pełny ekran przy wczytaniu strony
    window.addEventListener('load', function() {
      activateFullscreen();
      setTimeout(checkFullscreen, 500);
    });
    
    document.addEventListener('fullscreenchange', checkFullscreen);
    document.addEventListener('webkitfullscreenchange', checkFullscreen);
    document.addEventListener('mozfullscreenchange', checkFullscreen);
    document.addEventListener('MSFullscreenChange', checkFullscreen);
    
    function go(rating) {
      document.getElementById('ratingScreen').style.display = 'none';
      document.getElementById('thanksScreen').style.display = 'block';

      fetch('/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ loc: '<%= loc %>', rating: rating, comment: '' })
      })
      .then(r => r.json())
      .then(d => {
        if (!d.ok) console.log('Zapis się nie powiódł:', d);
      })
      .catch(e => console.log('Błąd zapisu:', e));

      setTimeout(() => {
        document.getElementById('thanksScreen').style.display = 'none';
        document.getElementById('ratingScreen').style.display = 'block';
      }, 3000);
    }
  </script>
</body>
</html>

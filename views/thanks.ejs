<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Dziękujemy</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    body { 
      font-family: Arial; 
      text-align: center; 
      padding: 20px; 
      background: #fff; 
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .wrapper { width: 100%; max-width: 800px; }
    img { width: 100px; margin: 20px auto; display: block; }
    h1 { font-size: clamp(2rem, 8vw, 3.5rem); color: #4CAF50; margin: 20px; }
    h2 { font-size: clamp(1.2rem, 4vw, 2rem); color: #333; margin: 20px; }
    .final-message { margin: 30px 0; }
    .final-message h1 { font-size: clamp(2rem, 8vw, 3.5rem); color: #4CAF50; margin-bottom: 10px; }
    .final-message h2 { font-size: clamp(1.5rem, 5vw, 2.5rem); color: #333; margin-top: 10px; }
  </style>
</head>
<body>
  <div class="wrapper">
    <img src="https://upload.wikimedia.org/wikipedia/commons/9/90/Mercedes-Logo.svg">
    <div class="final-message">
      <h1>Dziękujemy, Twoja opinia jest dla nas ważna</h1>
      <h2>Daimler Truck Retail Polska</h2>
    </div>
  </div>
  
  <script>
    window.addEventListener('load', function() {
      ensureFullscreen();
      save();
    });
    
    document.addEventListener('fullscreenchange', ensureFullscreen);
    document.addEventListener('webkitfullscreenchange', ensureFullscreen);
    document.addEventListener('mozfullscreenchange', ensureFullscreen);
    document.addEventListener('MSFullscreenChange', ensureFullscreen);
    
    function ensureFullscreen() {
      if (!document.fullscreenElement && 
          !document.webkitFullscreenElement && 
          !document.mozFullScreenElement && 
          !document.msFullscreenElement) {
        
        const elem = document.documentElement;
        
        if (elem.requestFullscreen) {
          elem.requestFullscreen().catch(err => console.log('Fullscreen error:', err));
        } else if (elem.webkitRequestFullscreen) {
          elem.webkitRequestFullscreen();
        } else if (elem.mozRequestFullScreen) {
          elem.mozRequestFullScreen();
        } else if (elem.msRequestFullscreen) {
          elem.msRequestFullscreen();
        }
      }
    }
    
    function save() {
      fetch('/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ loc: '<%= loc %>', rating: '<%= rating %>', comment: '' })
      })
      .then(r => r.json())
      .then(d => {
        if (!d.ok) console.log('Zapis się nie powiódł:', d);
      })
      .catch(e => console.log('Błąd zapisu:', e));

      setTimeout(() => location.href = '/<%= loc %>', 3000);
    }
  </script>
</body>
</html>
